# Production Environment Configuration
# Copy this file to .env.production and update with your actual values

# Database Configuration
DATABASE_URL=postgres://medusa_user:strong_password@your-db-host:5432/medusa_production?sslmode=require
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_STATEMENT_TIMEOUT=30000
DB_QUERY_TIMEOUT=30000
DB_HEALTH_CHECK_INTERVAL=60000

# Application Configuration
NODE_ENV=production
PORT=9000
APP_VERSION=1.0.0

# Security Configuration
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-for-production
COOKIE_SECRET=your-super-secret-cookie-key-minimum-32-characters-long-for-production

# CORS Configuration
STORE_CORS=https://yourdomain.com,https://www.yourdomain.com
ADMIN_CORS=https://admin.yourdomain.com
AUTH_CORS=https://admin.yourdomain.com

# Redis Configuration (Optional but recommended)
REDIS_URL=redis://default:redis_password@your-redis-host:6379/0
# For Redis Cluster:
# REDIS_CLUSTER_NODES=redis://node1:6379,redis://node2:6379,redis://node3:6379

# Stripe Configuration
STRIPE_API_KEY=sk_live_your_stripe_live_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_endpoint_secret

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_BUCKET=medusa-uploads

# Worker Management Configuration
ENABLE_CLUSTERING=true
WORKER_MIN=2
WORKER_MAX=8
WORKER_MAX_MEMORY=512
WORKER_AUTO_SCALE=true
WORKER_MEMORY_CHECK_INTERVAL=30000
WORKER_HEALTH_CHECK_INTERVAL=60000

# Medusa Configuration
MEDUSA_ADMIN_BACKEND_URL=https://api.yourdomain.com
MEDUSA_ADMIN_PATH=admin
MEDUSA_STORE_PATH=store
MEDUSA_AUTH_PATH=auth

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_REQUEST_LOGGING=true

# Performance Configuration
ENABLE_COMPRESSION=true
COMPRESSION_LEVEL=6
ENABLE_ETAG=true
TRUST_PROXY=true

# Email Configuration (if using email features)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key
# SMTP_FROM_EMAIL=noreply@yourdomain.com
# SMTP_FROM_NAME=Indecisive Wear Store

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# Session Configuration
SESSION_DURATION=86400  # 24 hours in seconds
SESSION_SECRET=your-session-secret-minimum-32-characters

# Rate Limiting Configuration
RATE_LIMIT_WINDOW=900000  # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100

# Monitoring Configuration (Optional)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# NEW_RELIC_LICENSE_KEY=your-new-relic-license-key
# DATADOG_API_KEY=your-datadog-api-key

# Feature Flags (Optional)
# ENABLE_ANALYTICS=true
# ENABLE_CUSTOMER_GROUPS=true
# ENABLE_GIFT_CARDS=true
# ENABLE_SALES_CHANNELS=true