# ===========================================
# INDECISIVE WEAR - ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ===========================================
# 🔐 SECURITY SECRETS (REQUIRED)
# ===========================================
# Generate strong random secrets (32+ characters)
# Use: openssl rand -hex 32
JWT_SECRET=your_super_secure_jwt_secret_here_32_chars_minimum
COOKIE_SECRET=your_super_secure_cookie_secret_here_32_chars_minimum

# ===========================================
# 🗄️  DATABASE CONFIGURATION
# ===========================================
# For local development with Docker
DATABASE_URL=postgres://postgres:your_secure_password@localhost:5432/medusa-db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=medusa-db

# For production (use your cloud provider's connection string)
# DATABASE_URL=postgres://user:password@your-db-host:5432/dbname?sslmode=require
# DATABASE_CA_CERT=your_ca_certificate_content

# ===========================================
# 🌐 CORS CONFIGURATION
# ===========================================
# Frontend URLs that can access the API
STORE_CORS=http://localhost:3000,https://your-domain.com
ADMIN_CORS=http://localhost:7001,http://localhost:9000,https://admin.your-domain.com
AUTH_CORS=http://localhost:3000,https://your-domain.com

# ===========================================
# 💳 STRIPE PAYMENT CONFIGURATION
# ===========================================
# Get from https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ===========================================
# 📁 SUPABASE CONFIGURATION
# ===========================================
# Get from https://app.supabase.com/project/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_BUCKET=your-storage-bucket-name

# ===========================================
# 🚀 DEPLOYMENT CONFIGURATION
# ===========================================
NODE_ENV=development
# For production: NODE_ENV=production

# ===========================================
# 📧 EMAIL CONFIGURATION (Optional)
# ===========================================
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-email-password

# ===========================================
# 📊 MONITORING & LOGGING (Optional)
# ===========================================
# SENTRY_DSN=https://your-sentry-dsn-here
# LOG_LEVEL=info

# ===========================================
# 🔧 DEVELOPMENT SETTINGS
# ===========================================
# PORT=9000
# REDIS_URL=redis://localhost:6379